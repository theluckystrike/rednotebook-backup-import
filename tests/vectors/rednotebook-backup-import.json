{
 "slug": "rednotebook-backup-import",
 "module": "rednotebook-backup-import/src",
 "function": "parseMonth",
 "note": "Each case names its export. A thrown error is stored as {error}. tests/vectors.test.ts runs each case.",
 "cases": [
  {
   "name": "acceptance 1: two-day backup gives two dated days",
   "function": "inspectFiles",
   "args": [
    {
     "2026-01.txt": "1:\n  Places: {Paris: null}\n  text: '= New year ='\n2:\n  text: !!python/unicode '日本語 😀'\n"
    }
   ],
   "expected": {
    "days": [
     {
      "date": "2026-01-01",
      "text": "= New year =",
      "categories": [
       {
        "name": "Places",
        "values": [
         "Paris"
        ]
       }
      ],
      "source": "2026-01.txt"
     },
     {
      "date": "2026-01-02",
      "text": "日本語 😀",
      "categories": [],
      "source": "2026-01.txt"
     }
    ],
    "sources": [
     {
      "path": "2026-01.txt",
      "month": "2026-01",
      "text": "1:\n  Places: {Paris: null}\n  text: '= New year ='\n2:\n  text: !!python/unicode '日本語 😀'\n"
     }
    ],
    "conflicts": [],
    "ignored": [],
    "empty": []
   }
  },
  {
   "name": "acceptance 2: category Places keeps value Paris",
   "function": "parseMonth",
   "args": [
    "2026-01.txt",
    "1: {Places: {Paris: null}, text: Hello}\n"
   ],
   "expected": [
    {
     "date": "2026-01-01",
     "text": "Hello",
     "categories": [
      {
       "name": "Places",
       "values": [
        "Paris"
       ]
      }
     ],
     "source": "2026-01.txt"
    }
   ]
  },
  {
   "name": "acceptance 3: Unicode text stays the same",
   "function": "parseMonth",
   "args": [
    "2026-01.txt",
    "2: {text: \"日本語 😀\"}\n"
   ],
   "expected": [
    {
     "date": "2026-01-02",
     "text": "日本語 😀",
     "categories": [],
     "source": "2026-01.txt"
    }
   ]
  },
  {
   "name": "acceptance 4: basic txt2tags becomes Markdown",
   "function": "convertTxt2tags",
   "args": [
    "= New year =\n**Bold**, //italic//, and [Example https://example.org]."
   ],
   "expected": {
    "markdown": "# New year\n**Bold**, *italic*, and [Example](https://example.org).",
    "reports": [],
    "images": []
   }
  },
  {
   "name": "acceptance 5: python/unicode scalar is text",
   "function": "parseMonth",
   "args": [
    "2026-01.txt",
    "1: {text: !!python/unicode 'Plain text'}\n"
   ],
   "expected": [
    {
     "date": "2026-01-01",
     "text": "Plain text",
     "categories": [],
     "source": "2026-01.txt"
    }
   ]
  },
  {
   "name": "acceptance 6a: python/object/apply is rejected",
   "function": "parseMonth",
   "args": [
    "2026-01.txt",
    "1: {text: !!python/object/apply:os.system ['echo unsafe']}\n"
   ],
   "expected": {
    "error": "2026-01.txt: Invalid YAML. Unresolved tag: tag:yaml.org,2002:python/object/apply:os.system"
   }
  },
  {
   "name": "acceptance 6b: day 32 is rejected",
   "function": "parseMonth",
   "args": [
    "2026-01.txt",
    "32: {text: Late}\n"
   ],
   "expected": {
    "error": "2026-01.txt: Invalid day 32 for 2026-01."
   }
  },
  {
   "name": "acceptance 7: two month files for one month are a conflict",
   "function": "inspectFiles",
   "args": [
    {
     "2026-01.txt": "1: {text: A}\n",
     "data/2026-01.txt": "1: {text: B}\n",
     "2026-02.txt": "3: {text: C}\n"
    }
   ],
   "expected": {
    "days": [
     {
      "date": "2026-02-03",
      "text": "C",
      "categories": [],
      "source": "2026-02.txt"
     }
    ],
    "sources": [
     {
      "path": "2026-02.txt",
      "month": "2026-02",
      "text": "3: {text: C}\n"
     }
    ],
    "conflicts": [
     "2026-01: 2 source files (2026-01.txt, data/2026-01.txt) map to the same dates. Skipped dates: 2026-01-01."
    ],
    "ignored": [],
    "empty": []
   }
  },
  {
   "name": "acceptance 8: absent external image stays as text with a report",
   "function": "convertTxt2tags",
   "args": [
    "Look: [\"\"/home/user/Pictures/cat\"\".jpg]"
   ],
   "expected": {
    "markdown": "Look: [\"\"/home/user/Pictures/cat\"\".jpg]",
    "reports": [
     "Image not copied: /home/user/Pictures/cat.jpg"
    ],
    "images": [
     "/home/user/Pictures/cat.jpg"
    ]
   }
  },
  {
   "name": "acceptance 9a: parent path in the ZIP is rejected",
   "function": "validateMembers",
   "args": [
    [
     {
      "name": "2026-01.txt",
      "size": 10
     },
     {
      "name": "../escape.txt",
      "size": 5
     }
    ]
   ],
   "expected": {
    "error": "The ZIP file has an unsafe path: ../escape.txt"
   }
  },
  {
   "name": "acceptance 9b: expanded data over 100 MiB is rejected",
   "function": "validateMembers",
   "args": [
    [
     {
      "name": "2026-01.txt",
      "size": 60000000
     },
     {
      "name": "2026-02.txt",
      "size": 60000000
     }
    ]
   ],
   "expected": {
    "error": "The expanded data exceeds 100 MiB."
   }
  },
  {
   "name": "absolute ZIP path is rejected",
   "function": "validateMembers",
   "args": [
    [
     {
      "name": "/etc/2026-01.txt",
      "size": 1
     }
    ]
   ],
   "expected": {
    "error": "The ZIP file has an unsafe path: /etc/2026-01.txt"
   }
  },
  {
   "name": "duplicate ZIP names are rejected",
   "function": "validateMembers",
   "args": [
    [
     {
      "name": "2026-01.txt",
      "size": 1
     },
     {
      "name": "2026-01.txt",
      "size": 1
     }
    ]
   ],
   "expected": {
    "error": "The ZIP file has a duplicate name: 2026-01.txt"
   }
  },
  {
   "name": "safe ZIP member list passes",
   "function": "validateMembers",
   "args": [
    [
     {
      "name": "data/",
      "size": 0
     },
     {
      "name": "data/2026-01.txt",
      "size": 100
     }
    ]
   ],
   "expected": "ok"
